# =============================================================================
# services/tool_totalseg/tool_totalseg.def  —  Apptainer / Singularity definition
#
# Builds a SIF image for the TotalSegmentator tool service on HPC clusters.
#
# Build
# -----
#   apptainer build tool_totalseg.sif tool_totalseg.def
#
# Run
# ---
#   apptainer run tool_totalseg.sif
# =============================================================================

Bootstrap: docker
From: python:3.11-slim

%labels
    service tool_totalseg
    port 8011

%environment
    export PYTHONUNBUFFERED=1

%files
    services/tool_totalseg/api.py /app/api.py

%post
    export TMPDIR=/scratch/project_2016517/furkan/tmp
    export PIP_CACHE_DIR=/scratch/project_2016517/furkan/tmp/pip_cache
    mkdir -p $TMPDIR $PIP_CACHE_DIR
    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir \
        fastapi==0.115.0 \
        "uvicorn[standard]==0.30.6" \
        pydantic==2.8.2 \
        numpy==2.2.6 \
        pillow==12.1.0 \
        nibabel==5.3.3 \
        totalsegmentator
    mkdir -p /app

%runscript
    cd /app
    exec uvicorn api:app --host 0.0.0.0 --port 8011 "$@"
